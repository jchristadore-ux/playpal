# PlayPal live launch — copy values into Vercel env / never commit secrets.

# ── Client (public) ─────────────────────────────────────────────────────────
# Firebase web config lives in index.html (PLAYPAL_FIREBASE_CONFIG).
# Optional public overrides in index.html → window.PLAYPAL_CONFIG:
#   apiBaseUrl: ''                         # blank = same origin as the PWA
#   stripePublishableKey: 'pk_test_...'
#   enforceProGates: false                 # true soft-blocks Trips/Stats

# ── Vercel serverless (api/) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Stringified Firebase service account JSON (single line).
# Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"playpal-sync"}

# The Brovisional handicap sync (docs/BROVISIONAL_SYNC.md). Unset = feature disabled (no-op).
PLAYPAL_INGEST_SECRET=shared-hmac-secret-same-as-brovisional
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/brovisional (required for the daily backstop).
CRON_SECRET=long-random-string
# Optional overrides:
# BROVISIONAL_INGEST_URL=https://brovisional.vercel.app/api/ingest/playpal
# PLAYPAL_BROV_GROUPS=GROUPCODE1,GROUPCODE2   # extra groups whose players map to the crew ids

# Ops: GET /api/health returns boolean flags for the vars above (never secret values).
