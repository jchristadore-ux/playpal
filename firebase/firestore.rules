rules_version = '2';

// PlayPal Firestore rules (live auth + group-scoped sync).
//
// Auth: Email/Password, Google, and optional Anonymous guest.
//   - users/{uid}: each signed-in user can read/write ONLY their own doc.
//     Pro entitlement (pro:true) is written by the Stripe webhook via Admin
//     SDK (bypasses rules). Clients may update profile fields but cannot
//     self-grant pro:true (see validates below).
//   - Group-scoped rounds/trips: still code-scoped so foursome sync works
//     for guests and signed-in users alike. Knowing the group id grants access.
//
// Deploy with:
//   npx firebase-tools deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Per-user profile + Pro entitlement ─────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid);

      // Create / update own doc, but never self-grant Pro or overwrite Stripe refs
      // once they exist. Admin SDK (webhook) bypasses these rules.
      allow create: if isSelf(uid)
                    && (!('pro' in request.resource.data) || request.resource.data.pro == false)
                    && !('stripeCheckoutSessionId' in request.resource.data)
                    && !('stripePaymentIntentId' in request.resource.data)
                    && !('entitlementKey' in request.resource.data);

      allow update: if isSelf(uid)
                    && request.resource.data.pro == resource.data.get('pro', false)
                    && request.resource.data.get('stripeCustomerId', null)
                         == resource.data.get('stripeCustomerId', null)
                    && request.resource.data.get('stripeCheckoutSessionId', null)
                         == resource.data.get('stripeCheckoutSessionId', null)
                    && request.resource.data.get('stripePaymentIntentId', null)
                         == resource.data.get('stripePaymentIntentId', null)
                    && request.resource.data.get('entitlementKey', null)
                         == resource.data.get('entitlementKey', null)
                    && request.resource.data.get('proGrantedAt', null)
                         == resource.data.get('proGrantedAt', null);

      allow delete: if false;
    }

    // ── Optional group ownership metadata (does not gate foursome sync) ────
    match /group_meta/{groupId} {
      allow read: if signedIn()
                  && groupId.matches('^[0-9A-Z]{8,40}$');
      allow create: if signedIn()
                    && groupId.matches('^[0-9A-Z]{8,40}$')
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    // ── Group-scoped data (current clients) ────────────────────────────────
    function isGroupRounds(c) { return c.matches('^g_[0-9A-Z]{8,40}_rounds$'); }
    function isGroupTrips(c)  { return c.matches('^g_[0-9A-Z]{8,40}_trips$'); }

    match /{collection}/{docId} {
      allow read:   if signedIn()
                    && (isGroupRounds(collection) || isGroupTrips(collection));
      allow write:  if signedIn() && (
                      (isGroupRounds(collection)
                        && docId.matches('^[A-Z0-9]{4,12}$')
                        && request.resource.size() < 50)
                      ||
                      (isGroupTrips(collection)
                        && docId.matches('^trip_[0-9]+$'))
                    );
      allow delete: if signedIn()
                    && (isGroupRounds(collection) || isGroupTrips(collection));
    }

    // ── Legacy unscoped data (installs that predate groups) ────────────────
    match /playpal_rounds/{syncCode} {
      allow read:  if signedIn();
      allow write: if signedIn()
                   && syncCode.matches('^[A-Z0-9]{4,12}$')
                   && request.resource.size() < 50;
    }

    match /golf_trips/{tripId} {
      allow read:   if signedIn();
      allow write:  if signedIn() && tripId.matches('^trip_[0-9]+$');
      allow delete: if signedIn();
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
