{
  "rules": {
    ".read": false,
    ".write": false,

    "groups": {
      "$groupId": {
        ".read": "auth != null && $groupId.matches(/^[0-9A-Z]{8,40}$/)",
        ".write": "auth != null && $groupId.matches(/^[0-9A-Z]{8,40}$/)",

        "players": {
          "$playerId": {
            ".validate": "$playerId.length <= 64 && newData.hasChildren()"
          }
        },
        "courses": {
          "$courseId": {
            ".validate": "$courseId.length <= 64 && newData.hasChildren()"
          }
        },
        "saved_rounds": {
          "$syncCode": {
            ".validate": "$syncCode.matches(/^[A-Z0-9]{4,12}$/) && newData.hasChildren(['syncCode']) && newData.child('syncCode').val() === $syncCode",
            "savedAt": { ".validate": "newData.isNumber()" }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "players": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$playerId": {
        ".validate": "$playerId.length <= 64 && newData.hasChildren()"
      }
    },
    "courses": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$courseId": {
        ".validate": "$courseId.length <= 64 && newData.hasChildren()"
      }
    },
    "saved_rounds": {
      ".read": "auth != null",
      "$syncCode": {
        ".write": "auth != null && $syncCode.matches(/^[A-Z0-9]{4,12}$/)",
        ".validate": "newData.hasChildren(['syncCode']) && newData.child('syncCode').val() === $syncCode",
        "savedAt": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
